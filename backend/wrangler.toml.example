name = "arki-api"
main = "build/worker/shim.mjs"
compatibility_date = "2024-09-23"

[build]
command = "cargo install -q worker-build@^0.8 && worker-build --release"

[[d1_databases]]
binding = "DB"
database_name = "arki-db"
database_id = "<YOUR_D1_DATABASE_ID>"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "IMAGES_BUCKET"
bucket_name = "arki-images"

[images]
binding = "IMAGES"

[vars]
CORS_ALLOW_ORIGIN = "https://<your-blog-domain>"
IMAGE_BASE_URL = "https://<your-image-domain>"

# Secret (not in this file): npx wrangler secret put ADMIN_TOKEN
