---
import type { PostSummary } from "../lib/api";
import { formatDate } from "../lib/site";

interface Props {
  posts: PostSummary[];
  /** 先頭の記事を大きく見せる（トップのみ） */
  feature?: boolean;
}
const { posts, feature = false } = Astro.props;
const yearOf = (iso: string): string => formatDate(iso).slice(0, 4);
---

{
  posts.length === 0 ? (
    <p class="empty">まだ記事がありません。</p>
  ) : (
    <ul class="post-list">
      {posts.flatMap((post, i) => [
        i > 0 && yearOf(post.published_at) !== yearOf(posts[i - 1].published_at) && (
          <li class="year-mark" role="presentation" aria-hidden="true">
            {yearOf(post.published_at)}
          </li>
        ),
        (
        <li class:list={{ "has-thumb": post.thumbnail, featured: feature && i === 0 }} style={`--i:${Math.min(i, 6)}`}>
          <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
          <div class="post-main">
            <a class="post-title" href={`/entry/${post.slug}`}>
              {post.title}
            </a>
            {post.categories.length > 0 && (
              <span class="tags">
                {post.categories.map((c) => (
                  <a href={`/category/${encodeURIComponent(c)}`}>{c}</a>
                ))}
              </span>
            )}
            {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
          </div>
          {post.thumbnail && <img class="thumb" src={post.thumbnail} alt="" loading="lazy" decoding="async" />}
        </li>
        ),
      ])}
    </ul>
  )
}
