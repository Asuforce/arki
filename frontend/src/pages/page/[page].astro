---
import PostList from "../../components/PostList.astro";
import Pagination from "../../components/Pagination.astro";
import Layout from "../../layouts/Layout.astro";
import { listPosts } from "../../lib/api";

const n = Number(Astro.params.page);
if (!Number.isInteger(n) || n < 1) return new Response("Not Found", { status: 404 });
if (n === 1) return Astro.redirect("/", 301);

const { posts, page, limit, total } = await listPosts({ page: n });
if (posts.length === 0) return new Response("Not Found", { status: 404 });
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=600");
---

<Layout title={`${page} ページ目`}>
  <PostList posts={posts} />
  <Pagination page={page} limit={limit} total={total} basePath="/" />
</Layout>
