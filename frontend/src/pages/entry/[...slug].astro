---
import Layout from "../../layouts/Layout.astro";
import { getPost } from "../../lib/api";
import { renderPost } from "../../lib/render";
import { formatDate } from "../../lib/site";

const slug = Astro.params.slug;
const post = slug ? await getPost(slug) : null;
if (!post) return new Response("Not Found", { status: 404 });

const html = renderPost(post.content);
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=600");
---

<Layout title={post.title} description={post.excerpt}>
  <div class="read-progress" aria-hidden="true"></div>
  <article class="post">
    <header>
      <h1>{post.title}</h1>
      <p class="meta">
        <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
        {
          post.categories.length > 0 && (
            <span class="tags">
              {post.categories.map((c) => (
                <a href={`/category/${encodeURIComponent(c)}`}>{c}</a>
              ))}
            </span>
          )
        }
      </p>
    </header>
    <div class="post-body" set:html={html} />
    <footer class="post-end">
      <span aria-hidden="true">◦</span>
      <a href="/" lang="en">← All entries</a>
    </footer>
  </article>
</Layout>

<script>
  const bar = document.querySelector<HTMLElement>(".read-progress");
  if (bar) {
    const update = (): void => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.setProperty("--p", String(max > 0 ? Math.min(1, window.scrollY / max) : 0));
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }
</script>
