<rect class="comp" x="490" y="60" width="190" height="90" rx="8"/><text class="t" x="585" y="88" text-anchor="middle">Tier rules</text><text class="d" x="585" y="108" text-anchor="middle">tier.rs</text><text class="d" x="585" y="126" text-anchor="middle">長さの門、2 択、閾値</text>
<rect class="comp" x="720" y="60" width="140" height="90" rx="8"/><text class="t" x="790" y="88" text-anchor="middle">Clef client</text><text class="d" x="790" y="108" text-anchor="middle">clef.rs</text><text class="d" x="790" y="126" text-anchor="middle">要求と応答の検査</text>
<rect class="store" x="285" y="230" width="120" height="50" rx="8"/><text class="t" x="345" y="260" text-anchor="middle">D1</text>
<rect class="ext" x="720" y="220" width="140" height="70" rx="8"/><text class="t" x="790" y="248" text-anchor="middle">Workers AI</text><text class="d" x="790" y="268" text-anchor="middle">Clef</text>
<path class="edge" d="M190 80L250 100" marker-end="url(#a)"/><text class="lbl" x="28" y="145">classify、PATCH</text>
<path class="edge" d="M440 105L490 105" marker-end="url(#a)"/>
