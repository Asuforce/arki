---
import PostList from "../../components/PostList.astro";
import Pagination from "../../components/Pagination.astro";
import Layout from "../../layouts/Layout.astro";
import { listPosts } from "../../lib/api";
import { LIST_PAGE_CACHE_CONTROL, PUBLIC_CACHE_CONTROL } from "../../lib/edge-cache";

const name = Astro.params.name ?? "";
const requested = Number(Astro.url.searchParams.get("page") ?? "1");
const n = Number.isInteger(requested) && requested >= 1 ? requested : 1;

const { posts, page, limit, total } = await listPosts({ page: n, category: name });
if (total === 0) return new Response("Not Found", { status: 404 });
const cacheControl = Astro.url.searchParams.size > 0 ? LIST_PAGE_CACHE_CONTROL : PUBLIC_CACHE_CONTROL;
Astro.response.headers.set("Cache-Control", cacheControl);
---

<Layout title={name}>
  <p class="kicker" lang="en">Category</p>
  <h1 class="page-title">{name}</h1>
  <PostList posts={posts} />
  <Pagination page={page} limit={limit} total={total} basePath={`/category/${encodeURIComponent(name)}`} />
</Layout>
