---
import PostList from "../../components/PostList.astro";
import Pagination from "../../components/Pagination.astro";
import Layout from "../../layouts/Layout.astro";
import { listPosts } from "../../lib/api";

const name = Astro.params.name ?? "";
const requested = Number(Astro.url.searchParams.get("page") ?? "1");
const n = Number.isInteger(requested) && requested >= 1 ? requested : 1;

const { posts, page, limit, total } = await listPosts({ page: n, category: name });
if (total === 0) return new Response("Not Found", { status: 404 });
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=600");
---

<Layout title={name}>
  <h1>{name}</h1>
  <PostList posts={posts} />
  <Pagination page={page} limit={limit} total={total} basePath={`/category/${encodeURIComponent(name)}`} />
</Layout>
