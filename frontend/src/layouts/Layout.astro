---
import "@asuforce/tintwork/fonts.css";
import "@asuforce/tintwork/tokens.css";
import "@asuforce/tintwork/base.css";
import "../styles/arki.css";
import "../styles/world.css";
import Ghost from "../components/Ghost.astro";
import Starfield from "../components/Starfield.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { authorName, siteTitle } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <meta name="theme-color" content="#000000" />
    <script is:inline>
      (function () {
        var theme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") theme = saved;
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", theme);
        document.querySelector('meta[name="theme-color"]').setAttribute("content", theme === "light" ? "#f5f4f0" : "#000000");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" lang="en" href="#main">Skip to content</a>
    <Starfield />
    <Ghost variant="float" />
    <header class="site-header">
      <div class="container">
        <a class="site-title" href="/"><Ghost variant="mark" />{siteTitle}</a>
        <div class="site-tools">
          <a class="site-nav" data-admin-only lang="en" href="/admin" hidden>Admin</a>
          <a class="site-nav" lang="en" href="/archive">Archive</a>
          <a class="site-nav" lang="en" href="/category">Category</a>
          <a class="site-nav" lang="en" href="/architecture">Architecture</a>
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <a href="/rss.xml">RSS</a>
        <small>© {authorName}{siteTitle && ` · ${siteTitle}`}</small>
      </div>
    </footer>
    <script>
      import { initWorld } from "../scripts/world";
      initWorld();
    </script>
    <script>
      function showAdminLink(): void {
        fetch("/whoami", { cache: "no-store" })
          .then((res) => (res.ok ? res.json() : null))
          .then((body: { admin?: boolean } | null) => {
            document.querySelectorAll<HTMLElement>("[data-admin-only]").forEach((el) => (el.hidden = !body?.admin));
          })
          .catch(() => {});
      }
      showAdminLink();
      // 戻るで bfcache から復元されたページは、ログインの前後で状態が古い
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) showAdminLink();
      });
    </script>
  </body>
</html>
