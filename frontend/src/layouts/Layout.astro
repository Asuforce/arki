---
import "@asuforce/tintwork/fonts.css";
import "@asuforce/tintwork/tokens.css";
import "@asuforce/tintwork/base.css";
import "../styles/arki.css";
import "../styles/world.css";
import Ghost from "../components/Ghost.astro";
import Starfield from "../components/Starfield.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { authorName, siteTitle } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}
const { title, description, type = "website" } = Astro.props;
const isAdmin = Boolean(Astro.locals.isAdmin);
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const ogDescription = description || "日常を忘れるな";
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const ogImage = new URL("/og.png", Astro.url.origin).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <meta name="theme-color" content="#000000" />
    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={`${siteTitle} — ${ogDescription}`} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${siteTitle} — ${ogDescription}`} />
    <script is:inline>
      (function () {
        var theme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") theme = saved;
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", theme);
        document.querySelector('meta[name="theme-color"]').setAttribute("content", theme === "light" ? "#f5f4f0" : "#000000");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" lang="en" href="#main">Skip to content</a>
    <Starfield />
    <Ghost variant="float" />
    <header class="site-header">
      <div class="container">
        <a class="site-title" href="/"><Ghost variant="mark" />{siteTitle}</a>
        <div class="site-tools">
          {isAdmin && <a class="site-nav" lang="en" href="/admin">Admin</a>}
          <a class="site-nav" lang="en" href="/search">Search</a>
          <a class="site-nav" lang="en" href="/archive">Archive</a>
          <a class="site-nav" lang="en" href="/category">Category</a>
          <a class="site-nav" lang="en" href="/architecture">Architecture</a>
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <a href="/rss.xml">RSS</a>
        <small>© {authorName}{siteTitle && ` · ${siteTitle}`}</small>
      </div>
    </footer>
    <script>
      import { initWorld } from "../scripts/world";
      initWorld();
    </script>
  </body>
</html>
